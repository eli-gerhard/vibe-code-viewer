{
  "name": "vibe-code-viewer",
  "version": "0.0.0",
  "description": "View a hierarchy of what a project does, generated by your own Claude Code or Codex CLI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eli-gerhard/vibe-code-viewer.git"
  },
  "bin": {
    "vibe-code-viewer": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch src/cli.ts --port 4748 --no-open",
    "dev:web": "vite",
    "embed": "node scripts/embed-web.ts",
    "build": "vite build && npm run embed && npm run build:cli",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.js --banner:js=\"import { createRequire as bannerCreateRequire } from 'node:module'; const require = bannerCreateRequire(import.meta.url);\"",
    "build:binaries": "npm run build && node scripts/build-binaries.ts",
    "typecheck": "tsc -p . && tsc -p src/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepare": "npm run embed",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@biomejs/biome": "^2.6.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@openai/codex-sdk": "^0.165.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-flextree": "^2.1.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "d3-flextree": "^2.1.2",
    "env-paths": "^4.0.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "which": "^7.0.0"
  }
}
