{
  "name": "vibe-code-viewer",
  "version": "0.0.0",
  "description": "View a hierarchy of what a project does, generated by your own Claude Code or Codex CLI.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eli-gerhard/vibe-code-viewer.git"
  },
  "bin": {
    "vibe-code-viewer": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch src/cli.ts --port 4748 --no-open",
    "dev:web": "vite",
    "embed": "node scripts/embed-web.ts",
    "build": "vite build && npm run embed && npm run build:cli",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "build:binaries": "npm run build && node scripts/build-binaries.ts",
    "typecheck": "tsc -p . && tsc -p src/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepare": "npm run embed",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@hono/node-server": "^2.1.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
